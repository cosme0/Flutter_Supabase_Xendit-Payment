# -----------------------------------------------------------------------------
# Local development configuration for the student shop.
#
# Copy this file to `.env` and fill in the real values:
#
#   cp .env.example .env          (Windows PowerShell: Copy-Item .env.example .env)
#
# The file is loaded with:
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# Only PUBLIC values belong here. Never put the Supabase service role key,
# the Xendit secret key or the Xendit webhook token into this file - they are
# stored as Supabase edge function secrets.
# -----------------------------------------------------------------------------

# Supabase project url of the project "BMC-ecom1" (organization "BMC").
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable key (or the legacy anon key) of the same project.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
