# -----------------------------------------------------------------------------
# Template for the local configuration of the student shop.
#
# Copy this file to `.env` and fill in the values:
#
#   Copy-Item .env.example .env
#
# The `.env` is git ignored - it is never committed.
#
# Build the APK with:
#   flutter build apk --release --dart-define-from-file=.env
# -----------------------------------------------------------------------------

# The url of the Supabase project that hosts the catalogue, the orders and the
# edge functions.
SUPABASE_URL=https://kfvxqsxycpmawgbwugyr.supabase.co

# The PUBLIC Supabase key (publishable key). It only grants the `anon` role:
# the app may read the catalogue and call the edge functions, but it can
# neither create an order nor mark an order as paid.
#
# Dashboard -> Project Settings -> API Keys -> Publishable key
SUPABASE_ANON_KEY=sb_publishable_IJvYbkAOlEZu1rDqquaKtg_FTmV5Pq7

# NOTE: the service role key and the Xendit secret key must NEVER be put here.
# They live in the Supabase edge function secrets:
#   XENDIT_SECRET_KEY, XENDIT_WEBHOOK_TOKEN
