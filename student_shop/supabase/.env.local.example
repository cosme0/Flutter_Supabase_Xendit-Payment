# -----------------------------------------------------------------------------
# Template for the edge function secrets of the student shop.
#
# Copy this file to `supabase/.env.local` and fill in the real values.
# `supabase/.env.local` is git ignored, only this template is committed.
#
#   Copy-Item supabase/.env.local.example supabase/.env.local
#
# The secrets are uploaded with:
#   supabase secrets set --env-file supabase/.env.local
# -----------------------------------------------------------------------------

# Xendit secret API key (TEST mode - the key starts with xnd_development_).
XENDIT_SECRET_KEY=xnd_development_YOUR_TEST_SECRET_KEY

# Verification token that Xendit sends in the `x-callback-token` header.
# The same value has to be configured in the Xendit dashboard
# (Developers -> Webhooks / Callbacks).
XENDIT_WEBHOOK_TOKEN=your-random-webhook-token

# Optional: the payment channels that the checkout page may show.
# Leave it empty to let Xendit show every channel of the account
# (for the BMC demo account that is GCash).
# XENDIT_PAYMENT_METHODS=GCASH,MAYA
